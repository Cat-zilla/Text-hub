<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose renders the whole UI; this theme only removes the system action bar and
         sets the window background so the first frame already matches the app. -->
    <style name="Theme.TextHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>
</resources>
